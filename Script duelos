mt.__index = newcclosure(function(self, key)
    if Config.SilentAim and key == "Hit" and self == Mouse then
        if SilentTarget and SilentTarget.Parent then
            local sp, onScreen = Camera:WorldToViewportPoint(SilentTarget.Position)
            if onScreen then
                local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if dist <= Config.SilentFOV then
                    return SilentTarget.CFrame
                end
            end
        end
    end
    return oldIndex(self, key)
end)

