local function UpdateESP()
    ClearESP()
    if not Config.ESP then return end

    local myHRP = select(2, GetChar())
    if not myHRP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local char, hrp, hum, head = GetChar(plr)
            if char and hrp and head and hum then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = char
                highlight.FillColor = Color3.fromRGB(255, 40, 40)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.55
                highlight.OutlineTransparency = 0
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = ESPFolder

                local bill = Instance.new("BillboardGui")
                bill.Adornee = head
                bill.Size = UDim2.fromOffset(140, 42)
                bill.StudsOffset = Vector3.new(0, 2.6, 0)
                bill.AlwaysOnTop = true
                bill.Parent = ESPFolder

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 0, 16)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = plr.Name
                nameLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
                nameLabel.TextStrokeTransparency = 0.2
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextSize = 13
                nameLabel.Parent = bill

                if Config.HealthESP then
                    local hpLabel = Instance.new("TextLabel")
                    hpLabel.Size = UDim2.new(1, 0, 0, 14)
                    hpLabel.Position = UDim2.fromOffset(0, 15)
                    hpLabel.BackgroundTransparency = 1
                    hpLabel.Text = math.floor(hum.Health) .. " HP"
                    hpLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                    hpLabel.TextStrokeTransparency = 0.3
                    hpLabel.Font = Enum.Font.Gotham
                    hpLabel.TextSize = 12
                    hpLabel.Parent = bill
                end

                if Config.DistanceESP then
                    local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                    local distLabel = Instance.new("TextLabel")
                    distLabel.Size = UDim2.new(1, 0, 0, 14)
                    distLabel.Position = UDim2.fromOffset(0, Config.HealthESP and 28 or 15)
                    distLabel.BackgroundTransparency = 1
                    distLabel.Text = dist .. " studs"
                    distLabel.TextColor3 = Color3.fromRGB(180, 180, 255)
                    distLabel.TextStrokeTransparency = 0.3
                    distLabel.Font = Enum.Font.Gotham
                    distLabel.TextSize = 11
                    distLabel.Parent = bill
                end
            end
        end
    end
end

local function CheckKills()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, _, hum = GetChar(plr)
            local prev = HealthCache[plr.UserId]
            if hum then
                local hp = hum.Health
                if prev and prev > 0 and hp <= 0 then
                    Rayfield:Notify({
                        Title = "KILL",
                        Content = "Mataste a " .. plr.Name,
                        Duration = 2.2,
                        Image = 4483362458,
                    })
                end
                HealthCache[plr.UserId] = hp
            else
                if prev and prev > 0 then
                    Rayfield:Notify({
                        Title = "KILL",
                        Content = "Mataste a " .. plr.Name,
                        Duration = 2.2,
                        Image = 4483362458,
                    })
                    HealthCache[plr.UserId] = 0
                end
            end
        end
    end
end

local function ApplyHitbox(plr)
    local char, hrp, hum, head = GetChar(plr)
    if not char or not hrp then return end

    if not HitboxCache[plr.UserId] then
        HitboxCache[plr.UserId] = {}
    end
    local cache = HitboxCache[plr.UserId]

    if Config.HitboxHRP then
        if not cache.HRP then
            cache.HRP = {
                Size = hrp.Size,
                Transparency = hrp.Transparency,
            }
        end
        if hrp.Size ~= Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize) then
            hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
            hrp.Transparency = Config.HitboxTransparency
        end
    end

    if Config.HitboxHead and head then
        if not cache.Head then
            cache.Head = {
                Size = head.Size,
                Transparency = head.Transparency,
            }
        end
        local headSize = Config.HitboxSize * 0.7
        if head.Size ~= Vector3.new(headSize, headSize, headSize) then
            head.Size = Vector3.new(headSize, headSize, headSize)
            head.Transparency = Config.HitboxTransparency
        end
    end
end

local function ResetHitbox(plr)
    local cache = HitboxCache[plr.UserId]
    if not cache then return end

    local char = plr.Character
    if not char then
        HitboxCache[plr.UserId] = nil
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")

    if hrp and cache.HRP then
        hrp.Size = cache.HRP.Size
        hrp.Transparency = cache.HRP.Transparency
    end
    if head and cache.Head then
        head.Size = cache.Head.Size
        head.Transparency = cache.Head.Transparency
    end

    HitboxCache[plr.UserId] = nil
end

local function UpdateHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            ApplyHitbox(plr)
        else
            ResetHitbox(plr)
        end
    end
end

local function ClearAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        ResetHitbox(plr)
    end
    table.clear(HitboxCache)
end

