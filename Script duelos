local function CheckKills()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, _, hum = GetChar(plr)
            local prev = HealthCache[plr.UserId]
            if hum then
                local hp = hum.Health
                if prev and prev > 0 and hp <= 0 and SpawnCFrame then
                    task.spawn(function()
                        task.wait(0.1)
                        local _, myHRP, myHum = GetChar()
                        if myHRP then
                            myHRP.CFrame = SpawnCFrame
                            myHRP.AssemblyLinearVelocity = Vector3.zero
                            myHRP.AssemblyAngularVelocity = Vector3.zero
                            if myHum then myHum.PlatformStand = false end
                        end
                        CurrentTarget = nil
                    end)
                end
                HealthCache[plr.UserId] = hp
            end
        end
    end
end

local function ApplyHitbox(plr)
    local char = plr.Character
    if not char then return end
    local part = char:FindFirstChild(Config.HitboxPart) or char:FindFirstChild("HumanoidRootPart")
    if not part or not part:IsA("BasePart") then return end

    if not HitboxCache[plr.UserId] then
        HitboxCache[plr.UserId] = {}
    end
    if not HitboxCache[plr.UserId][part.Name] then
        HitboxCache[plr.UserId][part.Name] = { Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide }
    end

    local targetSize = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
    if part.Size ~= targetSize then
        part.Size = targetSize
        part.Transparency = Config.HitboxTransparency
        part.CanCollide = false
        part.Massless = true
    end
end

local function ResetHitbox(plr)
    local cache = HitboxCache[plr.UserId]
    if not cache then return end
    local char = plr.Character
    if char then
        for partName, data in pairs(cache) do
            local part = char:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                part.Size = data.Size
                part.Transparency = data.Transparency
                part.CanCollide = data.CanCollide
                part.Massless = false
            end
        end
    end
    HitboxCache[plr.UserId] = nil
end

local function UpdateHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            ApplyHitbox(plr)
        else
            ResetHitbox(plr)
        end
    end
end

local function ClearAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        ResetHitbox(plr)
    end
    table.clear(HitboxCache)
end

