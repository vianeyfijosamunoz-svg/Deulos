    end
end

local function DrawLine(p1, p2, color)
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = color
    line.BorderSizePixel = 0
    line.Parent = ESPFolder
    
    local dist = (p1 - p2).Magnitude
    line.Size = UDim2.new(0, dist, 0, 2)
    line.Position = UDim2.new(0, (p1.X + p2.X) / 2, 0, (p1.Y + p2.Y) / 2)
    line.Rotation = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
    return line
end

local function UpdateESP()
    ClearESP()
    if not Config.ESP then return end

    local myHRP = select(2, GetChar())
    if not myHRP then return end
    local rainbowColor = GetRainbowColor()

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local char, hrp, hum, head = GetChar(plr)
            if char and hrp and head and hum then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = char
                highlight.FillColor = rainbowColor
                highlight.OutlineColor = rainbowColor
                highlight.FillTransparency = 0.55
                highlight.OutlineTransparency = 0
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = ESPFolder

                local bill = Instance.new("BillboardGui")
                bill.Adornee = head
                bill.Size = UDim2.fromOffset(140, 42)
                bill.StudsOffset = Vector3.new(0, 2.6, 0)
                bill.AlwaysOnTop = true
                bill.Parent = ESPFolder

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 0, 16)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = plr.Name
                nameLabel.TextColor3 = rainbowColor
                nameLabel.TextStrokeTransparency = 0.2
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextSize = 13
                nameLabel.Parent = bill

                if Config.HealthESP then
                    local hpLabel = Instance.new("TextLabel")
                    hpLabel.Size = UDim2.new(1, 0, 0, 14)
                    hpLabel.Position = UDim2.fromOffset(0, 15)
                    hpLabel.BackgroundTransparency = 1
                    hpLabel.Text = math.floor(hum.Health) .. " HP"
                    hpLabel.TextColor3 = rainbowColor
                    hpLabel.TextStrokeTransparency = 0.3
                    hpLabel.Font = Enum.Font.Gotham
                    hpLabel.TextSize = 12
                    hpLabel.Parent = bill
                end

                if Config.DistanceESP then
                    local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                    local distLabel = Instance.new("TextLabel")
                    distLabel.Size = UDim2.new(1, 0, 0, 14)
                    distLabel.Position = UDim2.fromOffset(0, Config.HealthESP and 28 or 15)
                    distLabel.BackgroundTransparency = 1
                    distLabel.Text = dist .. " studs"
                    distLabel.TextColor3 = rainbowColor
                    distLabel.TextStrokeTransparency = 0.3
                    distLabel.Font = Enum.Font.Gotham
                    distLabel.TextSize = 11
                    distLabel.Parent = bill
                end

                if Config.Tracers then
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        DrawLine(screenCenter, Vector2.new(hrpPos.X, hrpPos.Y), rainbowColor)
                    end
                end

                if Config.BoxESP then
                    local cf, size = char:GetBoundingBox()
                    local corners = {
                        cf * CFrame.new(size.X/2, size.Y/2, size.Z/2),
                        cf * CFrame.new(-size.X/2, size.Y/2, size.Z/2),
                        cf * CFrame.new(size.X/2, -size.Y/2, size.Z/2),
                        cf * CFrame.new(-size.X/2, -size.Y/2, size.Z/2),
                        cf * CFrame.new(size.X/2, size.Y/2, -size.Z/2),
                        cf * CFrame.new(-size.X/2, size.Y/2, -size.Z/2),
                        cf * CFrame.new(size.X/2, -size.Y/2, -size.Z/2),
                        cf * CFrame.new(-size.X/2, -size.Y/2, -size.Z/2)
                    }
                    local minX, minY = math.huge, math.huge
                    local maxX, maxY = -math.huge, -math.huge
                    local visible = false

                    for _, corner in ipairs(corners) do
                        local sp, onScreen = Camera:WorldToViewportPoint(corner.Position)
                        if onScreen then
                            visible = true
                            minX = math.min(minX, sp.X)
                            minY = math.min(minY, sp.Y)
                            maxX = math.max(maxX, sp.X)
                            maxY = math.max(maxY, sp.Y)
                        end
                    end

                    if visible then
                        local box = Instance.new("Frame")
                        box.BackgroundTransparency = 1
                        box.Position = UDim2.new(0, minX, 0, minY)
                        box.Size = UDim2.new(0, maxX - minX, 0, maxY - minY)
                        box.Parent = ESPFolder

                        local stroke = Instance.new("UIStroke")
                        stroke.Color = rainbowColor
                        stroke.Thickness = 1.5
                        stroke.Parent = box
                    end
                end

                if Config.SkeletonESP then
                    local function getPartPos(name)
                        local p = char:FindFirstChild(name)
                        if p then
                            local sp, onScreen = Camera:WorldToViewportPoint(p.Position)
                            if onScreen then return Vector2.new(sp.X, sp.Y) end
                        end
                        return nil
                    end

                    local headPos = getPartPos("Head")
                    local upperTorso = getPartPos("UpperTorso") or getPartPos("Torso")
                    local lowerTorso = getPartPos("LowerTorso") or getPartPos("Torso")
                    local leftUpperArm = getPartPos("LeftUpperArm") or getPartPos("Left Arm")
                    local leftLowerArm = getPartPos("LeftLowerArm") or getPartPos("Left Arm")
                    local rightUpperArm = getPartPos("RightUpperArm") or getPartPos("Right Arm")
                    local rightLowerArm = getPartPos("RightLowerArm") or getPartPos("Right Arm")
                    local leftUpperLeg = getPartPos("LeftUpperLeg") or getPartPos("Left Leg")
                    local leftLowerLeg = getPartPos("LeftLowerLeg") or getPartPos("Left Leg")
                    local rightUpperLeg = getPartPos("RightUpperLeg") or getPartPos("Right Leg")
                    local rightLowerLeg = getPartPos("RightLowerLeg") or getPartPos("Right Leg")

                    if headPos and upperTorso then DrawLine(headPos, upperTorso, rainbowColor) end
                    if upperTorso and lowerTorso then DrawLine(upperTorso, lowerTorso, rainbowColor) end
                    if upperTorso and leftUpperArm then DrawLine(upperTorso, leftUpperArm, rainbowColor) end
                    if leftUpperArm and leftLowerArm then DrawLine(leftUpperArm, leftLowerArm, rainbowColor) end
                    if upperTorso and rightUpperArm then DrawLine(upperTorso, rightUpperArm, rainbowColor) end
                    if rightUpperArm and rightLowerArm then DrawLine(rightUpperArm, rightLowerArm, rainbowColor) end
                    if lowerTorso and leftUpperLeg then DrawLine(lowerTorso, leftUpperLeg, rainbowColor) end
                    if leftUpperLeg and leftLowerLeg then DrawLine(leftUpperLeg, leftLowerLeg, rainbowColor) end
                    if lowerTorso and rightUpperLeg then DrawLine(lowerTorso, rightUpperLeg, rainbowColor) end
                    if rightUpperLeg and rightLowerLeg then DrawLine(rightUpperLeg, rightLowerLeg, rainbowColor) end
                end
            end
        end
    end
end

local function CheckKills()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, _, hum = GetChar(plr)
            local prev = HealthCache[plr.UserId]
            if hum then
                local hp = hum.Health
                if prev and prev > 0 and hp <= 0 then
                    Rayfield:Notify({
                        Title = "KILL",
                        Content = "Mataste a " .. plr.Name,
                        Duration = 2.2,
                        Image = 4483362458,
                    })
                    
                    if SpawnCFrame then
                        task.spawn(function()
                            task.wait(0.1)
                            local _, myHRP, myHum = GetChar()
                            if myHRP then
                                myHRP.CFrame = SpawnCFrame
                                myHRP.AssemblyLinearVelocity = Vector3.zero
                                myHRP.AssemblyAngularVelocity = Vector3.zero
                                if myHum then
                                    myHum.PlatformStand = false
                                end
                            end
                            CurrentTarget = nil
                        end)
                    end
                end
                HealthCache[plr.UserId] = hp
            else
                if prev and prev > 0 then
                    HealthCache[plr.UserId] = 0
                    if SpawnCFrame then
                        task.spawn(function()
                            task.wait(0.1)
                            local _, myHRP, myHum = GetChar()
                            if myHRP then
                                myHRP.CFrame = SpawnCFrame
                                myHRP.AssemblyLinearVelocity = Vector3.zero
                                myHRP.AssemblyAngularVelocity = Vector3.zero
                                if myHum then
                                    myHum.PlatformStand = false
                                end
                            end
                            CurrentTarget = nil
                        end)
                    end
                end
            end
        end
    end
end

local function ApplyHitbox(plr)
    local char = plr.Character
    if not char then return end

    local partsToExpand = {}
    if Config.HitboxHRP then table.insert(partsToExpand, char:FindFirstChild("HumanoidRootPart")) end
    if Config.HitboxHead then table.insert(partsToExpand, char:FindFirstChild("Head")) end
    if Config.HitboxLeftArm then 
        table.insert(partsToExpand, char:FindFirstChild("Left Arm"))
        table.insert(partsToExpand, char:FindFirstChild("LeftHand"))
        table.insert(partsToExpand, char:FindFirstChild("LeftLowerArm"))
        table.insert(partsToExpand, char:FindFirstChild("LeftUpperArm"))
    end
    if Config.HitboxRightArm then 
        table.insert(partsToExpand, char:FindFirstChild("Right Arm"))
        table.insert(partsToExpand, char:FindFirstChild("RightHand"))
        table.insert(partsToExpand, char:FindFirstChild("RightLowerArm"))
        table.insert(partsToExpand, char:FindFirstChild("RightUpperArm"))
    end
    if Config.HitboxLeftLeg then 
        table.insert(partsToExpand, char:FindFirstChild("Left Leg"))
        table.insert(partsToExpand, char:FindFirstChild("LeftFoot"))
        table.insert(partsToExpand, char:FindFirstChild("LeftLowerLeg"))
        table.insert(partsToExpand, char:FindFirstChild("LeftUpperLeg"))
    end
    if Config.HitboxRightLeg then 
        table.insert(partsToExpand, char:FindFirstChild("Right Leg"))
        table.insert(partsToExpand, char:FindFirstChild("RightFoot"))
        table.insert(partsToExpand, char:FindFirstChild("RightLowerLeg"))
        table.insert(partsToExpand, char:FindFirstChild("RightUpperLeg"))
    end

    if not HitboxCache[plr.UserId] then
        HitboxCache[plr.UserId] = {}
    end

    for _, part in ipairs(partsToExpand) do
        if part and part:IsA("BasePart") then
            if not HitboxCache[plr.UserId][part.Name] then
                HitboxCache[plr.UserId][part.Name] = { Size = part.Size, Transparency = part.Transparency }
            end
            local targetSize = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
            if part.Size ~= targetSize then
                part.Size = targetSize
                part.Transparency = Config.HitboxTransparency
                part.CanCollide = false
            end
        end
    end
end

local function ResetHitbox(plr)
    local cache = HitboxCache[plr.UserId]
    if not cache then return end

    local char = plr.Character
    if char then
        for partName, data in pairs(cache) do
            local part = char:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                part.Size = data.Size
                part.Transparency = data.Transparency
                part.CanCollide = true
            end
        end
    end

    HitboxCache[plr.UserId] = nil
end

local function UpdateHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            ApplyHitbox(plr)
        else
            ResetHitbox(plr)
        end
    end
end

local function ClearAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        ResetHitbox(plr)
    end
    table.clear(HitboxCache)
end

local mt = getrawmetatable(game)
