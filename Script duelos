local function GetRainbowColor()
    local hue = (tick() % 5) / 5
    return Color3.fromHSV(hue, 1, 1)
end

local function GetChar(plr)
    plr = plr or LocalPlayer
    local c = plr.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    local head = c:FindFirstChild("Head")
    if hrp and hum and hum.Health > 0 then
        return c, hrp, hum, head
    end
end

local function UpdateSpawnPosition()
    local _, hrp = GetChar()
    if hrp and not SpawnCFrame then
        SpawnCFrame = hrp.CFrame
    end
end

local function HasGreenArrow(char)
    if not char then return false end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BillboardGui") then
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("ImageLabel") or child:IsA("TextLabel") then
                    local color = child:IsA("ImageLabel") and child.ImageColor3 or child.TextColor3
                    if color and color.G > (color.R * 1.5) and color.G > (color.B * 1.5) and color.G > 0.4 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function IsEnemy(plr)
    if plr == LocalPlayer or not plr.Character then return false end
    local char = plr.Character
    if HasGreenArrow(char) then return false end
    
    local success, isFriend = pcall(function()
        return LocalPlayer:IsFriendsWith(plr.UserId)
    end)
    if success and isFriend then return false end

    if LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
        return false
    end

    local _, hrp = GetChar(plr)
    return hrp ~= nil
end

local function IsVisible(part)
    if not part then return end
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(origin, part.Position - origin, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

local function GetTargetByFOV(customFOV)
    local best, bestPart, bestDist = nil, nil, customFOV
    local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local char, hrp, hum, head = GetChar(plr)
            if char and head then
                if Config.VisibleCheck and not IsVisible(head) then continue end
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if dist <= customFOV and dist < bestDist then
                        bestDist = dist
                        best = plr
                        bestPart = head
                    end
                end
            end
        end
    end
    return best, bestPart
end

local function AimAt(targetPart)
    if not targetPart then return end
    local targetChar = targetPart.Parent
    local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local predictedPosition = targetPart.Position
    if targetHRP then
        predictedPosition = predictedPosition + (targetHRP.AssemblyLinearVelocity * Config.Prediction)
    end
    local targetCFrame = CFrame.new(Camera.CFrame.Position, predictedPosition)
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(Config.Smoothness, 0.01, 1))
end

local function GetBestTargetForTP()
    local bestPlr, bestHrp = nil, nil
    local shortestDist = math.huge
    local myHRP = select(2, GetChar())
    if not myHRP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, hrp, hum = GetChar(plr)
            if hrp and hum then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestPlr = plr
                    bestHrp = hrp
                end
            end
        end
    end
    return bestPlr, bestHrp
end

local function LockAndEquipKnife()
    if not Config.TP or not Config.AutoKnife then return end
    local char, _, hum = GetChar()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    local hasKnifeEquipped = false
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("knife") or name:find("cuchillo") or name:find("blade") or name:find("dagger") or name:find("karambit") then
                hasKnifeEquipped = true
                break
            end
        end
    end

    if not hasKnifeEquipped then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("cuchillo") or name:find("blade") or name:find("dagger") or name:find("karambit") then
                    if hum then hum:EquipTool(tool) end
                    break
                end
            end
        end
    end
end

local function HandleFPSBoost()
    if not Config.FPSBoost then return end
    local function muteSounds(parent)
        if not parent then return end
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("Sound") then
                local sName = obj.Name:lower()
                local parentName = obj.Parent and obj.Parent.Name:lower() or ""
                if sName:find("shoot") or sName:find("fire") or sName:find("gun") or sName:find("shot") or sName:find("bullet") or sName:find("reload") or sName:find("equip") or parentName:find("weapon") or parentName:find("gun") or parentName:find("tool") then
                    obj.Volume = 0
                end
            end
        end
    end
    muteSounds(Workspace)
    muteSounds(SoundService)
    if LocalPlayer.Character then muteSounds(LocalPlayer.Character) end
    if LocalPlayer:FindFirstChild("Backpack") then muteSounds(LocalPlayer.Backpack) end

    if not TexturesRemoved then
        TexturesRemoved = true
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Texture") or obj:IsA("Decal") then
                    obj:Destroy()
                elseif obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                end
            end
            for _, obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("PostEffect") or obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
                    obj:Destroy()
                end
            end
        end)
    end
end

local function DoTP(eHrp, targetPlayer)
    local char, myHRP, myHum = GetChar()
    if not myHRP or not eHrp or not char then return end
    local now = tick()
    if now - LastTP < Config.TPCooldown then return end
    LastTP = now

    pcall(function()
        myHRP.Anchored = false
        if myHum then
            myHum.PlatformStand = true
            myHum:ChangeState(Enum.HumanoidStateType.Physics)
        end
        local targetPos = eHrp.Position + Vector3.new(0, -4.9, 0)
        myHRP.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), math.rad(180), 0)
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
    end)
end

