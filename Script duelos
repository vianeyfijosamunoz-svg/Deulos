end

local function GetChar(plr)
    plr = plr or LocalPlayer
    local c = plr.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    local head = c:FindFirstChild("Head")
    if hrp and hum and hum.Health > 0 then
        return c, hrp, hum, head
    end
end

local function IsEnemy(plr)
    if plr == LocalPlayer then return false end
    if not plr.Character then return false end
    if Config.TeamCheck then
        if LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
            return false
        end
    end
    local _, hrp = GetChar(plr)
    if not hrp then return false end
    return true
end

local function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, part.Position - origin, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

local function GetBestEnemy(needVisible)
    local best, bestPart, bestDist = nil, nil, Config.FOV
    local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local char, hrp, hum, head = GetChar(plr)
            if char and head then
                if needVisible and Config.VisibleCheck and not IsVisible(head) then continue end
                local sp, on = Camera:WorldToViewportPoint(head.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = plr
                        bestPart = head
                    end
                end
            end
        end
    end
    return best, bestPart
end

local function GetClosestEnemy3D()
    local best, bestPart, bestDist = nil, nil, math.huge
    local myHRP = select(2, GetChar())
    if not myHRP then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, hrp, hum, head = GetChar(plr)
            if hrp and hum then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = plr
                    bestPart = head or hrp
                end
            end
        end
    end
    return best, bestPart
end

local function AimAt(part)
    if not part then return end
    local pos = part.Position
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude > 0.4 then
        pos = pos + vel * Config.Prediction
    end
    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, pos), Config.Smoothness)
end

local function DoTP(eHrp)
    local _, myHRP, myHum = GetChar()
    if not myHRP or not eHrp then return end
    local now = tick()
    if now - LastTP < Config.TPCooldown then return end
    LastTP = now
    pcall(function()
        myHRP.Anchored = false
        if myHum then
            myHum.PlatformStand = false
        end
        myHRP.CFrame = CFrame.new(eHrp.Position + Vector3.new(0, 0.3, 0), eHrp.Position)
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function FireKnife(targetPos)
    pcall(function()
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                if n:find("knife") or n:find("throw") or n:find("slash") or n:find("attack") or n:find("damage") or n:find("hit") or n:find("combat") then
                    pcall(function()
                        v:FireServer(targetPos)
                        v:FireServer(targetPos, true)
                        v:FireServer("Knife", targetPos)
                    end)
                end
            end
        end
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("RemoteEvent") then
                        pcall(function()
                            v:FireServer(targetPos)
                        end)
                    end
                end
            end
        end
    end)
end

local function KnifeAITick()
    if not Config.KnifeAI then return end
    local now = tick()
    if now - LastKnife < Config.KnifeDelay then return end
    LastKnife = now

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, hrp, hum, head = GetChar(plr)
            if hrp and hum and hum.Health > 0 then
                local pos = (head or hrp).Position
                FireKnife(pos)
                FireKnife(pos + Vector3.new(0, 0.5, 0))
            end
        end
    end
end

local function KillAllTick()
    if not Config.KillAll then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, hrp, hum, head = GetChar(plr)
            if hrp and hum and hum.Health > 0 then
                local pos = (head or hrp).Position
                FireKnife(pos)
                pcall(function()
                    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                        if v:IsA("RemoteEvent") then
                            local n = v.Name:lower()
                            if n:find("kill") or n:find("damage") or n:find("hit") then
                                pcall(function()
                                    v:FireServer(plr)
                                    v:FireServer(plr.Character)
                                    v:FireServer(hum, 100)
                                end)
                            end
                        end
                    end
                end)
            end
        end
    end
end

local function CheckMyKills()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, _, hum = GetChar(plr)
            if hum then
                local prev = HealthCache[plr.UserId]
                local hp = hum.Health
                if prev and prev > 0 and hp <= 0 then
                    PlayBubble()
                    Notify("KILL → " .. plr.Name, Theme.Green, 1.5)
                end
                HealthCache[plr.UserId] = hp
            else
                local prev = HealthCache[plr.UserId]
                if prev and prev > 0 then
                    PlayBubble()
                    Notify("KILL → " .. plr.Name, Theme.Green, 1.5)
                    HealthCache[plr.UserId] = 0
                end
            end
        end
    end
end

