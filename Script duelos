local function GetChar(plr)
    plr = plr or LocalPlayer
    local c = plr.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    local head = c:FindFirstChild("Head")
    if hrp and hum and hum.Health > 0 then
        return c, hrp, hum, head
    end
end

local function IsEnemy(plr)
    if plr == LocalPlayer or not plr.Character then return false end
    if Config.TeamCheck and LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
        return false
    end
    local _, hrp = GetChar(plr)
    return hrp ~= nil
end

local function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, part.Position - origin, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

local function GetBestEnemy()
    local best, bestPart, bestDist = nil, nil, Config.FOV
    local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local char, hrp, hum, head = GetChar(plr)
            if char and head then
                if Config.VisibleCheck and not IsVisible(head) then continue end
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = plr
                        bestPart = head
                    end
                end
            end
        end
    end
    return best, bestPart
end

local function GetClosestEnemy3D()
    local best, bestPart, bestDist = nil, nil, math.huge
    local myHRP = select(2, GetChar())
    if not myHRP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, hrp, hum, head = GetChar(plr)
            if hrp and hum then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = plr
                    bestPart = head or hrp
                end
            end
        end
    end
    return best, bestPart
end

local function AimAt(part)
    if not part then return end
    local pos = part.Position
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude > 0.3 then
        pos = pos + vel * Config.Prediction
    end
    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, pos), Config.Smoothness)
end

local function DoTP(eHrp)
    local _, myHRP, myHum = GetChar()
    if not myHRP or not eHrp then return end
    local now = tick()
    if now - LastTP < Config.TPCooldown then return end
    LastTP = now

    pcall(function()
        myHRP.Anchored = false
        if myHum then myHum.PlatformStand = false end
        myHRP.CFrame = CFrame.new(eHrp.Position + Vector3.new(0, 0.15, 0))
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function SetNoclip(state)
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end
    if state then
        NoclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

local function ClearESP()
    for _, v in ipairs(ESPFolder:GetChildren()) do
        v:Destroy()
    end
end

local function UpdateESP()
    ClearESP()
    if not Config.ESP then return end

    local myHRP = select(2, GetChar())
    if not myHRP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local char, hrp, hum, head = GetChar(plr)
            if char and hrp and head and hum then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = char
                highlight.FillColor = Color3.fromRGB(255, 50, 50)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.6
                highlight.OutlineTransparency = 0
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = ESPFolder

                local bill = Instance.new("BillboardGui")
                bill.Adornee = head
                bill.Size = UDim2.fromOffset(140, 40)
                bill.StudsOffset = Vector3.new(0, 2.6, 0)
                bill.AlwaysOnTop = true
                bill.Parent = ESPFolder

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 0, 16)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = plr.Name
                nameLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                nameLabel.TextStrokeTransparency = 0.2
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextSize = 13
                nameLabel.Parent = bill

                if Config.HealthESP then
                    local hpLabel = Instance.new("TextLabel")
                    hpLabel.Size = UDim2.new(1, 0, 0, 14)
                    hpLabel.Position = UDim2.fromOffset(0, 14)
                    hpLabel.BackgroundTransparency = 1
                    hpLabel.Text = math.floor(hum.Health) .. " HP"
                    hpLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                    hpLabel.TextStrokeTransparency = 0.3
                    hpLabel.Font = Enum.Font.Gotham
                    hpLabel.TextSize = 12
                    hpLabel.Parent = bill
                end

                if Config.DistanceESP then
                    local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                    local distLabel = Instance.new("TextLabel")
                    distLabel.Size = UDim2.new(1, 0, 0, 14)
                    distLabel.Position = UDim2.fromOffset(0, Config.HealthESP and 26 or 14)
                    distLabel.BackgroundTransparency = 1
                    distLabel.Text = dist .. " studs"
                    distLabel.TextColor3 = Color3.fromRGB(200, 200, 255)
                    distLabel.TextStrokeTransparency = 0.3
                    distLabel.Font = Enum.Font.Gotham
                    distLabel.TextSize = 11
                    distLabel.Parent = bill
                end

                if Config.Tracers then
                    local line = Drawing.new("Line")
                    line.Thickness = 1.2
                    line.Color = Color3.fromRGB(255, 60, 60)
                    line.Transparency = 0.4
                    line.Visible = true

                    local from = Camera:WorldToViewportPoint(myHRP.Position)
                    local to = Camera:WorldToViewportPoint(hrp.Position)
                    line.From = Vector2.new(from.X, from.Y)
                    line.To = Vector2.new(to.X, to.Y)

                    task.spawn(function()
                        while line and Config.Tracers and Config.ESP do
                            local myPos = select(2, GetChar())
                            if not myPos or not hrp or not hrp.Parent then
                                line:Remove()
                                break
                            end
                            local f = Camera:WorldToViewportPoint(myPos.Position)
                            local t = Camera:WorldToViewportPoint(hrp.Position)
                            line.From = Vector2.new(f.X, f.Y)
                            line.To = Vector2.new(t.X, t.Y)
                            task.wait()
                        end
                        if line then line:Remove() end
                    end)
                end
            end
        end
    end
end

local function CheckKills()
    for _, plr in ipairs(Players:GetPlayers()) do
        if IsEnemy(plr) then
            local _, _, hum = GetChar(plr)
            local prev = HealthCache[plr.UserId]
            if hum then
                local hp = hum.Health
                if prev and prev > 0 and hp <= 0 then
                    Rayfield:Notify({
                        Title = "KILL",
                        Content = "Mataste a " .. plr.Name,
                        Duration = 2.5,
                        Image = 4483362458,
                    })
                end
                HealthCache[plr.UserId] = hp
            else
                if prev and prev > 0 then
                    Rayfield:Notify({
                        Title = "KILL",
                        Content = "Mataste a " .. plr.Name,
                        Duration = 2.5,
                        Image = 4483362458,
                    })
                    HealthCache[plr.UserId] = 0
                end
            end
        end
    end
end

local function TriggerbotTick()
    if not Config.Triggerbot then return end
    local target = Mouse.Target
    if target and target.Parent then
        local hum = target.Parent:FindFirstChildOfClass("Humanoid") or target.Parent.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local plr = Players:GetPlayerFromCharacter(hum.Parent)
            if plr and IsEnemy(plr) then
                mouse1click()
            end
        end
    end
end

