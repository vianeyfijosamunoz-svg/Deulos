Connections[#Connections + 1] = RunService.Heartbeat:Connect(function()
    if not Loaded then return end
    local char, hrp, hum = GetChar()
    if not char then return end

    local smooth = (Config.Smoothness > 1) and (Config.Smoothness / 100) or Config.Smoothness
    Config.Smoothness = math.clamp(smooth, 0.04, 0.35)

    if Config.AimAssist then
        local plr, part = GetBestEnemy(true)
        if part then
            CurrentTarget = plr
            AimAt(part)
        else
            CurrentTarget = nil
        end
    end

    if Config.TP then
        local plr, part = GetClosestEnemy3D()
        if plr then
            local _, eHrp = GetChar(plr)
            if eHrp then
                DoTP(eHrp)
            end
        end
    end

    if Config.KnifeAI then
        KnifeAITick()
    end

    if Config.KillAll then
        KillAllTick()
    end

    CheckMyKills()
end)

