        b.BackgroundColor3 = on and Theme.Green or Color3.fromRGB(45, 45, 55)
        c.Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3)
        Notify(text .. (on and " ON" or " OFF"), on and Theme.Green or Theme.Dim, 0.7)
        if cb then cb(on) end
    end)
