RunService.Heartbeat:Connect(function()
    if not Loaded then return end
    local char, hrp, hum = GetChar()
    if not char then return end

    if hum and Config.WalkSpeed ~= 16 then
        hum.WalkSpeed = Config.WalkSpeed
    end

    if Config.AimAssist then
        local _, part = GetBestEnemy()
        if part then AimAt(part) end
    end

    if Config.SilentAim then
        local _, part = GetBestEnemy()
        SilentTarget = part
    else
        SilentTarget = nil
    end

    if Config.TP then
        AutoEquipKnife()
        local plr = GetClosestEnemy3D()
        if plr then
            local _, eHrp = GetChar(plr)
            if eHrp then
                DoTP(eHrp, plr)
            end
        else
            CurrentTarget = nil
        end
    end

    if Config.ESP and tick() - LastESPUpdate > 0.35 then
        LastESPUpdate = tick()
        UpdateESP()
    end

    if Config.HitboxExpander then
        if tick() - LastHitboxUpdate > 0.15 then
            LastHitboxUpdate = tick()
            UpdateHitboxes()
        end
    elseif next(HitboxCache) then
        ClearAllHitboxes()
    end

    CheckKills()
end)

