RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local rainbowColor = GetRainbowColor()

    if Config.AimAssistFOVVisible then
        AimFOVCircle.Position = screenCenter
        AimFOVCircle.Radius = Config.AimAssistFOV
        AimFOVCircle.Color = rainbowColor
        AimFOVCircle.Visible = true
    else
        AimFOVCircle.Visible = false
    end

    if Config.SilentFOVVisible then
        SilentFOVCircle.Position = screenCenter
        SilentFOVCircle.Radius = Config.SilentFOV
        SilentFOVCircle.Color = rainbowColor
        SilentFOVCircle.Visible = true
    else
        SilentFOVCircle.Visible = false
    end
end)

RunService.Heartbeat:Connect(function()
    if not Loaded then return end
    local char, _, hum = GetChar()
    if not char then return end

    UpdateSpawnPosition()

    if hum and Config.WalkSpeed ~= 16 then
        hum.WalkSpeed = Config.WalkSpeed
    end

    if Config.AimAssist then
        local _, part = GetTargetByFOV(Config.AimAssistFOV)
        if part then AimAt(part) end
    end

    if Config.SilentAim then
        local _, part = GetTargetByFOV(Config.SilentFOV)
        SilentTarget = part
    else
        SilentTarget = nil
    end

    if Config.TP then
        LockAndEquipKnife()
        local bestPlr, eHrp = GetBestTargetForTP()
        if bestPlr and eHrp then
            DoTP(eHrp, bestPlr)
        else
            CurrentTarget = nil
        end
    end

    if Config.RainbowWeapons then
        HandleRainbowWeapons()
    end

    if Config.ESP and tick() - LastESPUpdate > 0.03 then
        LastESPUpdate = tick()
        UpdateESP()
    end

    if Config.HitboxExpander then
        if tick() - LastHitboxUpdate > 0.15 then
            LastHitboxUpdate = tick()
            UpdateHitboxes()
        end
    elseif next(HitboxCache) then
        ClearAllHitboxes()
    end

    CheckKills()
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    LastTP = 0
    CurrentTarget = nil
    SilentTarget = nil
    SpawnCFrame = nil
    local _, _, hum = GetChar()
    if hum then hum.WalkSpeed = Config.WalkSpeed end
    if Config.Noclip then SetNoclip(true) end
end)

